{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "clangd": {
      "command": ["clangd"],
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".h", ".hpp", ".hh", ".hxx"]
    },
    "basedpyright": {
      "command": ["uvx", "--from", "basedpyright", "basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "ls": "allow"
    }
  }
}
